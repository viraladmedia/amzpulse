VITE_API_BASE=

# Server-side only. Never expose these as VITE_* variables.
GEMINI_API_KEY=

# Product data providers. Configure at least one; when several are set they're tried in
# order (PA-API, SP-API, Keepa, Rainforest, Jungle Scout by default) and each one only
# fills in the ASINs the previous one couldn't find. Override the order/subset with
# PRODUCT_DATA_PROVIDERS, e.g. "keepa,paapi" or "spapi" alone.
PRODUCT_DATA_PROVIDERS=

AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_MARKETPLACE=www.amazon.com
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_LANGUAGE=en_US

# Amazon Selling Partner API - the official long-term replacement for PA-API. Requires a
# seller account with an SP-API app registered and authorized for it.
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_REGION=na
SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER

KEEPA_API_KEY=
KEEPA_DOMAIN=1

RAINFOREST_API_KEY=
RAINFOREST_AMAZON_DOMAIN=amazon.com

JUNGLESCOUT_KEY_NAME=
JUNGLESCOUT_API_KEY=
JUNGLESCOUT_MARKETPLACE=us

FEATURED_ASINS=

# Trending Now + All-Time Best Sellers rails on the dashboard. Rainforest-only for now
# (needs RAINFOREST_API_KEY above) — Keepa has an equivalent bestsellers endpoint but
# it isn't wired up yet. Both *_CATEGORY_URL vars take a full Amazon bestsellers-
# CATEGORY-page URL (the site-wide amazon.com/gp/bestsellers page is a category index,
# not a ranked list, so it won't work here), e.g.
# https://www.amazon.com/Best-Sellers-Home-Kitchen/zgbs/home-garden
# Defaults: Electronics for Trending, Toys & Games for Best Sellers — set these
# explicitly if a rail shows "no data" (Amazon occasionally changes a category's slug).
TRENDING_CATEGORY_URL=
TRENDING_LIMIT=12
BESTSELLERS_CATEGORY_URL=
BESTSELLERS_LIMIT=12
