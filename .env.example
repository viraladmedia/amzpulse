VITE_API_BASE=

# Server-side only. Never expose these as VITE_* variables.
GEMINI_API_KEY=

# Product data providers. Configure at least one; when several are set they're tried in
# order (PA-API, then Keepa, then Jungle Scout by default) and each one only fills in the
# ASINs the previous one couldn't find. Override the order/subset with PRODUCT_DATA_PROVIDERS,
# e.g. "keepa,paapi".
PRODUCT_DATA_PROVIDERS=

AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_MARKETPLACE=www.amazon.com
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_LANGUAGE=en_US

KEEPA_API_KEY=
KEEPA_DOMAIN=1

JUNGLESCOUT_KEY_NAME=
JUNGLESCOUT_API_KEY=
JUNGLESCOUT_MARKETPLACE=us

FEATURED_ASINS=
